[Unit]
Description=People provisioning agent
After=network-online.target ssh.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/people-agent
EnvironmentFile=/etc/people-agent/people-agent.env
ExecStart=/opt/people-agent/people-agent

Restart=on-failure
RestartSec=3

PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/home /etc /var/lib/people-agent

[Install]
WantedBy=multi-user.target
